# =============================================================================
# H@H-rs Environment Configuration
# =============================================================================
#
# Copy this file to .env and fill in your values:
#   cp env.example .env
#
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: H@H Client Credentials
# -----------------------------------------------------------------------------
# Get these from https://e-hentai.org/hentaiathome.php after registering a client

# Your H@H client ID (numeric)
HAH_CLIENT_ID=

# Your H@H client key (alphanumeric string)
HAH_CLIENT_KEY=

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------

# Port to listen on (default: 8080)
HAH_PORT=8080

# Address to bind to (default: 0.0.0.0 for all interfaces)
HAH_BIND_ADDRESS=0.0.0.0

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------

# Directory to store cached files
HAH_CACHE_DIR=./cache

# Directory for temporary downloads
HAH_TEMP_DIR=./temp

# Path to SQLite database for tracking cache
HAH_DATABASE_PATH=./data/hah.db

# Maximum cache size in GB (default: 100)
HAH_CACHE_SIZE_GB=100

# Maximum disk usage percentage (0-99, default: 95)
HAH_MAX_DISK_USAGE=95

# -----------------------------------------------------------------------------
# Gallery Download Configuration
# -----------------------------------------------------------------------------
# These settings control the gallery download feature that allows you to
# pre-fetch images from galleries you're browsing on the site.

# Enable gallery downloading (true/false, default: true)
HAH_GALLERY_DOWNLOAD=true

# API endpoint for gallery metadata
HAH_GALLERY_API=https://api.e-hentai.org

# Number of concurrent download workers (default: 4)
HAH_DOWNLOAD_WORKERS=4

# -----------------------------------------------------------------------------
# ExHentai Access (Optional)
# -----------------------------------------------------------------------------
# To access ExHentai content, you need to provide your login cookies.
# Get these from your browser after logging into exhentai.org
# (Check browser DevTools > Application > Cookies)

# ipb_member_id cookie value
HAH_EXHENTAI_MEMBER_ID=

# ipb_pass_hash cookie value
HAH_EXHENTAI_PASS_HASH=

# igneous cookie value (only available after logging in via ExHentai)
HAH_EXHENTAI_IGNEOUS=

# -----------------------------------------------------------------------------
# Logging Configuration
# -----------------------------------------------------------------------------

# Log level: trace, debug, info, warn, error (default: info)
HAH_LOG_LEVEL=info

# Output logs as JSON (true/false, default: false)
# Set to true for Docker/production environments for easier parsing
HAH_LOG_JSON=false

# -----------------------------------------------------------------------------
# Performance Configuration
# -----------------------------------------------------------------------------

# Request timeout in seconds (default: 30)
HAH_REQUEST_TIMEOUT=30

# -----------------------------------------------------------------------------
# Bandwidth Throttling (Optional)
# -----------------------------------------------------------------------------
# Control upload and download speeds to manage bandwidth usage.
# Set to -1 for unlimited (default).

# Maximum upload speed in KB/s (-1 = unlimited)
HAH_MAX_UPLOAD_SPEED=-1

# Maximum download speed in KB/s (-1 = unlimited)
HAH_MAX_DOWNLOAD_SPEED=-1

# Maximum hourly bandwidth in MB (-1 = unlimited)
# Useful for ISPs with hourly traffic limits
HAH_MAX_HOURLY_BANDWIDTH=-1

# -----------------------------------------------------------------------------
# Advanced H@H Features
# -----------------------------------------------------------------------------

# Enable static range assignments (proactive caching)
# When enabled, the client will download and cache files for hash ranges
# assigned by the server. This improves network efficiency but increases
# disk and bandwidth usage. (default: false)
HAH_STATIC_RANGES=false

# Enable proxy mode for uncached files
# When enabled, requests for files not in cache will be proxied from
# the H@H network instead of returning 404. (default: false)
HAH_PROXY_MODE=false

# Minimum free disk space to maintain in GB (default: 5)
# Cache eviction will trigger when free space falls below this threshold.
HAH_MIN_FREE_SPACE_GB=5

# Enable metrics collection for monitoring (default: true)
HAH_ENABLE_METRICS=true

# -----------------------------------------------------------------------------
# Terminal User Interface (TUI)
# -----------------------------------------------------------------------------
# Enable the TUI dashboard for real-time monitoring in the terminal.
# When enabled, standard logging is disabled to avoid conflicts.
# Use --tui flag or set this to true.

# Enable TUI dashboard (default: false)
HAH_TUI=false

# -----------------------------------------------------------------------------
# Docker Volume Paths (only used by docker-compose.yml)
# -----------------------------------------------------------------------------
# These define where Docker volumes are stored on the host system.
# Adjust these paths to match your preferred storage locations.

HAH_CACHE_PATH=./data/cache
HAH_TEMP_PATH=./data/temp
HAH_DATA_PATH=./data/db
